# 기본 구성: 로컬 임베딩 + 로컬 CE + Qdrant 로컬 영속 저장.
# configs/main.yaml: embedding_backend=local, ce_backend=local, qdrant_mode=local.

# 로컬 임베딩·CE: 모델 ID와 고정된 커밋 SHA를 기본값으로 지정했습니다.
# 공식 모델 정보 확인: 2026-10-12.
# https://huggingface.co/BAAI/bge-m3
# https://huggingface.co/BAAI/bge-reranker-v2-m3
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
CE_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
CE_LOCAL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# CPU를 기본으로 사용합니다. GPU 사용 시 지원 여부를 확인하고 cuda/mps로 변경하세요.
MODEL_DEVICE=cpu
# 선택: 인증이 필요한 Hugging Face 모델/계정을 사용할 때만 입력합니다.
HF_TOKEN=
# 모델 ID를 사용하면 최초 실행 시 가중치를 다운로드하고 아래 경로에 보관합니다.
MODEL_CACHE_DIR=.cache/models

# Qdrant: qdrant_mode=local이면 아래 주소·키는 사용하지 않습니다.
# qdrant_mode=remote일 때는 실제 서버/Cloud 주소와 필요한 키를 입력하세요.
QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=
# configs/env-qdrant.yaml: 기존 컬렉션의 정확한 이름 (버전 접미사를 붙이지 않음).
# 비우면 demo/connection-check를 제외한 컬렉션이 하나일 때 자동 선택.
QDRANT_COLLECTION=
# named dense vector를 여러 개 쓰는 컬렉션이면 검색할 벡터 이름.
QDRANT_VECTOR_NAME=

# Jev: 직접 입력할 필수 항목은 JEV_API_KEY입니다.
# 공식 API 예시 alias를 기본값으로 사용합니다. 계정의 /v1/models 응답을 확인하세요.
# 논문 실험에서는 가능하면 alias 대신 고정된 모델 이름으로 변경하세요.
# https://api.typesafe.ai/openapi.json
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
# 비용 비교 시 직접 입력: 입력 100만 토큰당 USD.
JEV_INPUT_USD_PER_MILLION=
# 공식 OpenAPI의 Usage 설명에서 출력 토큰 무료임을 확인했습니다(2026-10-12).
JEV_OUTPUT_USD_PER_MILLION=0

# 답변 생성: generate=true인 현재 설정에서는 주소와 모델을 직접 입력해야 합니다.
# /chat/completions 호환 서비스 또는 로컬 LLM 서버를 사용하세요.
# BASE_URL에는 /chat/completions를 붙이지 않습니다. 서비스에 따라 /v1을 포함하세요.
# 인증이 필요한 서비스이면 API_KEY도 입력하세요.
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL=
# 비용 비교 시 직접 입력: 입력·출력 각각 100만 토큰당 USD.
GENERATION_INPUT_USD_PER_MILLION=
GENERATION_OUTPUT_USD_PER_MILLION=

# 자동 보조 평가: judge 명령을 실행할 때만 JUDGE_MODEL을 직접 입력하세요.
# 기본적으로 생성 서비스와 같은 주소·키를 재사용합니다.
# 별도 서비스를 쓰면 아래 주소·키를 해당 서비스 값으로 변경하세요.
# 평가 모델은 생성 모델과 별도로 선택합니다.
JUDGE_BASE_URL=${GENERATION_BASE_URL}
JUDGE_API_KEY=${GENERATION_API_KEY}
JUDGE_MODEL=
JUDGE_INPUT_USD_PER_MILLION=
JUDGE_OUTPUT_USD_PER_MILLION=

# HTTP 임베딩: embedding_backend=http로 변경할 때만 직접 입력합니다.
# 현재 로컬 임베딩 구성에서는 모두 비워둬도 됩니다.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_INPUT_USD_PER_MILLION=

# HTTP CE: ce_backend=http로 변경할 때만 직접 입력합니다.
# 현재 로컬 CE 구성에서는 모두 비워둬도 됩니다.
CE_BASE_URL=
CE_API_KEY=
CE_API_MODEL=
CE_INPUT_USD_PER_MILLION=
CE_OUTPUT_USD_PER_MILLION=

# 캐시 위치: 기본값을 그대로 사용해도 됩니다.
TIKTOKEN_CACHE_DIR=.cache/tiktoken
MPLCONFIGDIR=.cache/matplotlib

# 비용 비교 시 직접 입력: 로컬 모델·검색 연산의 시간당 USD 비용 기준.
# 빈 단가는 미확인(null)으로 기록합니다. 무료인 경우에만 명시적으로 0을 입력하세요.
LOCAL_USD_PER_HOUR=
